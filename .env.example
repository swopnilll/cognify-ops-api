PORT=3000

# Postgres (DIRECT_URL can be the same as DATABASE_URL unless you use a pooler)
DATABASE_URL=postgresql://cognify:password@localhost:5432/cognify
DIRECT_URL=postgresql://cognify:password@localhost:5432/cognify

# Auth: signs the login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# SQS (SQS_ENDPOINT only for local ElasticMQ; leave empty on AWS)
AWS_REGION=ap-southeast-2
SQS_QUEUE_URL=
SQS_ENDPOINT=
